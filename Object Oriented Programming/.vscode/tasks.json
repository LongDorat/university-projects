{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Java: build & run active file",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-NoExit",
        "-File", "${workspaceFolder}\\Build-ActiveFile.ps1",
        "-ActiveFilePath", "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}